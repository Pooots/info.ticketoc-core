# Content is loaded from the CMS public API (cms-web-ws). Both values end up in the browser bundle;
# they are public identifiers, not secrets. Copy to .env.local (development) or .env.production.local.
# When either value is empty, the original hard-coded landing page is shown instead.
VITE_CMS_API_URL=http://localhost:8000
VITE_CMS_SITE_KEY=ticketoc-info
# Optional: serve customer websites created from Ticketoc starters on subdomains of this domain
# (must match CMS_HOSTING_TICKETOC_URL in cms-web-ws, e.g. http://{subdomain}.ticketoc.localhost:3000).
# Other hostnames keep showing VITE_CMS_SITE_KEY.
VITE_CMS_TENANT_DOMAIN=
